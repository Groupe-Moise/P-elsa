generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  VENDOR
  DELIVERY
  TAXI
  MOTORBIKE
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  PENDING
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum TransactionType {
  TRANSFER
  DEPOSIT
  WITHDRAWAL

  /// Conversion d'un solde d'une devise vers une autre, à
  /// l'intérieur du même wallet (voir le module `exchange`).
  EXCHANGE

  /// Paiement d'un client vers un marchand (compte VENDOR), identifié
  /// par son code marchand plutôt que par son numéro de téléphone
  /// (voir TransactionsService.createPayment). Distinct de TRANSFER
  /// pour pouvoir les compter et les afficher séparément.
  PAYMENT
}

enum LedgerAccountKind {
  /// Le compte "argent" d'un wallet utilisateur. Son solde,
  /// calculé à partir de ses écritures, doit toujours égaler
  /// Wallet.balance.
  WALLET

  /// Les commissions perçues par P-ELSA sur les retraits.
  /// Compte séparé des wallets utilisateurs (fonds propres).
  PLATFORM_COMMISSION

  /// Représente les fonds côté opérateur Mobile Money : reçus
  /// lors d'un dépôt, à verser lors d'un retrait. Sert de
  /// contrepartie pour équilibrer chaque écriture.
  PLATFORM_FLOAT

  /// Réserve de change P-ELSA : contrepartie des conversions
  /// entre devises (bureau de change). Un compte par devise,
  /// débité quand un utilisateur reçoit cette devise en échange
  /// d'une autre, crédité quand il la donne. Distinct de
  /// PLATFORM_FLOAT, qui concerne uniquement les opérateurs
  /// Mobile Money.
  PLATFORM_EXCHANGE
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                String     @id @default(uuid())
  phone             String     @unique
  email             String?    @unique
  firstName         String
  lastName          String
  pinHash           String

  /// Échecs de PIN consécutifs (remis à 0 après un succès).
  pinFailedAttempts Int        @default(0)

  /// Le PIN est bloqué jusqu'à cette date après trop d'échecs.
  pinLockedUntil    DateTime?

  role              UserRole   @default(CLIENT)
  status            UserStatus @default(ACTIVE)

  /// Code marchand, uniquement pour un compte VENDOR : identifie ce
  /// compte pour un paiement (voir TransactionsService.createPayment)
  /// à la place d'un numéro de téléphone, généré par le marchand
  /// lui-même depuis l'app (voir UsersService.generateMerchantCode) et
  /// affiché sous forme de QR code à présenter aux clients. `null`
  /// tant qu'il n'a pas encore été généré, ou pour tout autre rôle.
  merchantCode      String?    @unique
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  wallet            Wallet?

  sentTransactions     Transaction[] @relation("SenderTransactions")
  receivedTransactions Transaction[] @relation("ReceiverTransactions")

  /// Actions d'administration effectuées PAR cet utilisateur
  /// (uniquement rempli pour un compte ADMIN).
  adminAuditLogs       AdminAuditLog[]

  @@index([role])
  @@index([status])
  @@map("users")
}

/// =========================================================
/// JOURNAL D'AUDIT DES ACTIONS D'ADMINISTRATION
/// =========================================================
///
/// Chaque action effectuée depuis les routes /admin (relance,
/// annulation, suspension de compte, déblocage de PIN...) laisse
/// une trace ici : qui, quoi, sur quelle cible, quand. Aucune
/// ligne n'est jamais modifiée ni supprimée.
model AdminAuditLog {
  id          String   @id @default(uuid())

  /// Administrateur qui a effectué l'action.
  adminUserId String

  /// Ex. TRANSACTION_RETRY, TRANSACTION_CANCEL, USER_SUSPEND,
  /// USER_REACTIVATE, USER_UNLOCK_PIN.
  action      String

  /// Ex. "transaction", "user".
  targetType  String
  targetId    String?

  /// Détails libres (raison fournie, ancien/nouveau statut...).
  details     Json?

  createdAt   DateTime @default(now())

  adminUser   User     @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model Currency {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  symbol    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  walletBalances WalletBalance[]
  ledgerAccounts LedgerAccount[]
  ledgerEntries  LedgerEntry[]
  transactions   Transaction[]

  /// Transactions d'EXCHANGE où cette devise est la devise CIBLE
  /// (voir Transaction.toCurrencyId) ; `transactions` ci-dessus
  /// couvre déjà la devise source via `currencyId`.
  transactionsAsToCurrency Transaction[] @relation("TransactionToCurrency")

  /// Taux de change où cette devise est la devise de DÉPART.
  exchangeRatesFrom ExchangeRate[] @relation("ExchangeRateFrom")

  /// Taux de change où cette devise est la devise D'ARRIVÉE.
  exchangeRatesTo   ExchangeRate[] @relation("ExchangeRateTo")

  @@map("currencies")
}

model Wallet {
  id         String       @id @default(uuid())
  userId     String       @unique
  status     WalletStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])

  sentTransactions     Transaction[]   @relation("SenderWalletTransactions")
  receivedTransactions Transaction[]   @relation("ReceiverWalletTransactions")
  ledgerAccounts       LedgerAccount[]
  balances             WalletBalance[]

  @@index([status])
  @@map("wallets")
}

/// =========================================================
/// SOLDE D'UN WALLET, PAR DEVISE
/// =========================================================
///
/// Un wallet peut détenir un solde dans plusieurs devises
/// (ex. USD et CDF pour un utilisateur en RDC). Chaque paire
/// (wallet, devise) a sa propre ligne, créée à la demande
/// (à l'inscription pour les devises du pays de l'utilisateur,
/// puis pour toute nouvelle devise ajoutée plus tard).
model WalletBalance {
  id         String   @id @default(uuid())
  walletId   String
  currencyId String
  balance    Decimal  @default(0) @db.Decimal(20, 4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  wallet   Wallet   @relation(fields: [walletId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  @@unique([walletId, currencyId])
  @@index([currencyId])
  @@map("wallet_balances")
}

model Transaction {
  id               String            @id @default(uuid())
  reference        String            @unique
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  amount           Decimal           @db.Decimal(20, 4)
  fee              Decimal           @default(0) @db.Decimal(20, 4)
  totalAmount      Decimal           @db.Decimal(20, 4)

  senderUserId     String?
  receiverUserId   String?
  senderWalletId   String?
  receiverWalletId String?

  description      String?

  /// Devise de l'opération. Pour un EXCHANGE, c'est la devise
  /// SOURCE (celle débitée) ; voir `toCurrencyId` pour la devise
  /// cible. Vide uniquement pour les transactions créées avant
  /// l'ajout du multi-devises (USD à l'époque).
  currencyId        String?

  /// Devise CIBLE d'un EXCHANGE uniquement (celle créditée sur le
  /// wallet) ; toujours vide pour les autres types de transaction.
  toCurrencyId      String?

  /// Taux utilisé pour un EXCHANGE (montant en devise cible pour 1
  /// unité de devise source), figé au moment de l'opération même
  /// si le taux courant change ensuite ; toujours vide pour les
  /// autres types de transaction.
  rate              Decimal? @db.Decimal(20, 8)

  /// Fournisseur de paiement qui exécute l'opération (ex. sandbox,
  /// maishapay) et référence de l'opération chez ce fournisseur.
  /// Ensemble, ils permettent de retrouver la transaction quand le
  /// fournisseur confirme le résultat par webhook.
  provider          String?
  providerReference String?

  /// Réseau Mobile Money (ex. Airtel Money) et numéro concerné.
  network           String?
  counterpartyPhone String?

  /// Motif renvoyé par le fournisseur quand l'opération échoue.
  failureReason     String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  senderUser     User?   @relation("SenderTransactions", fields: [senderUserId], references: [id])
  receiverUser   User? @relation("ReceiverTransactions", fields: [receiverUserId], references: [id])

  senderWallet   Wallet? @relation("SenderWalletTransactions", fields: [senderWalletId], references: [id])
  receiverWallet Wallet? @relation("ReceiverWalletTransactions", fields: [receiverWalletId], references: [id])

  currency       Currency? @relation(fields: [currencyId], references: [id])
  toCurrency     Currency? @relation("TransactionToCurrency", fields: [toCurrencyId], references: [id])

  ledgerEntries  LedgerEntry[]

  /// Un même fournisseur ne peut pas avoir deux transactions avec la
  /// même référence (les valeurs vides ne sont pas comparées).
  @@unique([provider, providerReference])
  @@index([type])
  @@index([status])
  @@index([senderUserId])
  @@index([receiverUserId])
  @@index([createdAt])
  @@map("transactions")
}

/// =========================================================
/// CLÉS D'IDEMPOTENCE
/// =========================================================
///
/// Empêche qu'un dépôt, un retrait ou un transfert soit
/// exécuté deux fois si le client (l'application) relance
/// la même opération après une coupure réseau.
///
/// Le client génère une clé unique avant chaque tentative et
/// la renvoie à l'identique s'il doit réessayer. Le serveur
/// exécute l'opération une seule fois et renvoie le même
/// résultat pour chaque nouvelle tentative avec cette clé.
model IdempotencyKey {
  id        String            @id @default(uuid())
  userId    String
  key       String
  status    IdempotencyStatus @default(PENDING)

  /// Résultat de l'opération, renvoyé tel quel en cas de
  /// nouvelle tentative avec la même clé.
  response  Json?

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// =========================================================
/// LEDGER : COMPTABILITÉ À DOUBLE ENTRÉE
/// =========================================================
///
/// Chaque mouvement d'argent (dépôt, retrait, transfert) est
/// enregistré en plus du solde du wallet, sous la forme
/// d'écritures dont la somme est toujours nulle : un compte
/// est crédité, un autre est débité du même montant.
///
/// Le solde d'un wallet (Wallet.balance) reste la valeur
/// utilisée pour les vérifications rapides (ex. le débit
/// conditionnel qui empêche la double dépense). Le ledger est
/// la source de vérité comptable : il doit être possible de
/// prouver à tout moment que la somme des écritures d'un
/// compte WALLET égale son Wallet.balance (voir
/// LedgerService.reconcileWallet).
model LedgerAccount {
  id         String            @id @default(uuid())
  kind       LedgerAccountKind

  /// Renseigné uniquement pour les comptes WALLET.
  walletId   String?

  currencyId String
  createdAt  DateTime          @default(now())

  wallet     Wallet?           @relation(fields: [walletId], references: [id])
  currency   Currency          @relation(fields: [currencyId], references: [id])
  entries    LedgerEntry[]

  /// Un wallet a un compte de ledger par devise qu'il détient
  /// (voir WalletBalance) ; les comptes de plateforme ont
  /// walletId = null et ne sont pas contraints par cet index
  /// (Postgres traite chaque NULL comme distinct).
  @@unique([walletId, currencyId])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id            String        @id @default(uuid())
  accountId     String

  /// La transaction (dépôt, retrait, transfert) à l'origine de
  /// cette écriture, pour remonter du ledger vers l'opération.
  transactionId String?

  /// Montant signé : positif crédite le compte, négatif le
  /// débite. La somme des écritures d'une même opération doit
  /// toujours être nulle.
  amount        Decimal       @db.Decimal(20, 4)

  currencyId    String
  description   String?
  createdAt     DateTime      @default(now())

  account       LedgerAccount @relation(fields: [accountId], references: [id])
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
  currency      Currency      @relation(fields: [currencyId], references: [id])

  @@index([accountId])
  @@index([transactionId])
  @@map("ledger_entries")
}

/// =========================================================
/// TAUX DE CHANGE (BUREAU DE CHANGE)
/// =========================================================
///
/// Un taux par sens de conversion (ex. USD -> CDF), géré par un
/// admin pour l'instant (aucun panneau admin dédié pour le moment :
/// mis à jour directement en base, ou via un futur endpoint
/// /admin/exchange-rates). `rate` = combien d'unités de
/// `toCurrency` pour 1 unité de `fromCurrency`.
///
/// Le sens inverse (CDF -> USD) est une ligne séparée, pas
/// calculée comme 1 / rate, pour permettre plus tard une marge
/// différente selon le sens si nécessaire — même si les deux sens
/// utilisent la même valeur en pratique tant qu'aucun frais n'est
/// appliqué (voir ExchangeService).
model ExchangeRate {
  id             String   @id @default(uuid())
  fromCurrencyId String
  toCurrencyId   String
  rate           Decimal  @db.Decimal(20, 8)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fromCurrency   Currency @relation("ExchangeRateFrom", fields: [fromCurrencyId], references: [id])
  toCurrency     Currency @relation("ExchangeRateTo", fields: [toCurrencyId], references: [id])

  @@unique([fromCurrencyId, toCurrencyId])
  @@map("exchange_rates")
}