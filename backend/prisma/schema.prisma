generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  VENDOR
  DELIVERY
  TAXI
  MOTORBIKE
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  PENDING
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum TransactionType {
  TRANSFER
  DEPOSIT
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id            String     @id @default(uuid())
  phone         String     @unique
  email         String?    @unique
  firstName     String
  lastName      String
  role          UserRole   @default(CLIENT)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  wallet        Wallet?

  sentTransactions     Transaction[] @relation("SenderTransactions")
  receivedTransactions Transaction[] @relation("ReceiverTransactions")

  @@index([role])
  @@index([status])
  @@map("users")
}

model Currency {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  symbol    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets Wallet[]

  @@map("currencies")
}

model Wallet {
  id         String       @id @default(uuid())
  userId     String       @unique
  currencyId String
  balance    Decimal      @default(0) @db.Decimal(20, 4)
  status     WalletStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  sentTransactions     Transaction[] @relation("SenderWalletTransactions")
  receivedTransactions Transaction[] @relation("ReceiverWalletTransactions")

  @@index([currencyId])
  @@index([status])
  @@map("wallets")
}

model Transaction {
  id               String            @id @default(uuid())
  reference        String            @unique
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  amount           Decimal           @db.Decimal(20, 4)
  fee              Decimal           @default(0) @db.Decimal(20, 4)
  totalAmount      Decimal           @db.Decimal(20, 4)

  senderUserId     String?
  receiverUserId   String?
  senderWalletId   String?
  receiverWalletId String?

  description      String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  senderUser     User?   @relation("SenderTransactions", fields: [senderUserId], references: [id])
  receiverUser   User?   @relation("ReceiverTransactions", fields: [receiverUserId], references: [id])

  senderWallet   Wallet? @relation("SenderWalletTransactions", fields: [senderWalletId], references: [id])
  receiverWallet Wallet? @relation("ReceiverWalletTransactions", fields: [receiverWalletId], references: [id])

  @@index([type])
  @@index([status])
  @@index([senderUserId])
  @@index([receiverUserId])
  @@index([createdAt])
  @@map("transactions")
}